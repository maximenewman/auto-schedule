{
  "name": "auto-schedule",
  "version": "0.1.0",
  "private": true,
  "description": "Headless agent that scrapes course sources and syncs schedule items to Google Calendar.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "run": "node dist/index.js run",
    "dev": "tsx src/index.ts run",
    "serve": "node dist/server/index.js",
    "serve:dev": "tsx src/server/index.ts",
    "setup:google": "tsx src/index.ts setup:google",
    "setup:coursys": "tsx src/index.ts setup:coursys",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@types/pdf-parse": "^1.1.5",
    "ai": "^4.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "googleapis": "^144.0.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.9",
    "puppeteer": "^23.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
