# OpenRouter (Vercel AI SDK uses OpenAI provider pointed here)
OPENROUTER_API_KEY=

# Google OAuth (Gmail + Calendar)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# Notifier — set one of these
NTFY_TOPIC=
# PUSHOVER_TOKEN=
# PUSHOVER_USER=

# Logging
LOG_LEVEL=info
