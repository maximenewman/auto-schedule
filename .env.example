# Postgres (Neon) — required
DATABASE_URL=

# Clerk auth — required
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Signs the Google OAuth state cookie
SESSION_SECRET=

# Base URL the server is reachable at (OAuth redirects) — e.g. http://localhost:8787
PUBLIC_BASE_URL=

# OpenRouter (Vercel AI SDK uses OpenAI provider pointed here)
OPENROUTER_API_KEY=

# Google OAuth — OPTIONAL, only for "Connect Google Calendar"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# Canvas LMS
CANVAS_BASE_URL=https://canvas.sfu.ca

# Tigris object storage (S3-compatible) — optional; file downloads are skipped without it
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
BUCKET_NAME=

# In-process sync scheduler (cloud deploys). Set ENABLE_SCHEDULER=1 to activate.
ENABLE_SCHEDULER=
SYNC_CRON=0 */6 * * *

# Notifier — set one of these
NTFY_TOPIC=
# PUSHOVER_TOKEN=
# PUSHOVER_USER=

# Logging
LOG_LEVEL=info
